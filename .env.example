# Centras CodeAI — Required Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# Without Supabase configured, the app runs in Demo Mode:
# mock client (localStorage DB) + mock LLM responses — no keys required.

# ── Supabase (client-side) ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Edge Function Secrets (set in Supabase Dashboard, NOT here) ──────────
# These NEVER go into the client bundle. Set via:
#   supabase secrets set GEMINI_API_KEY=AIza...
#
# GEMINI_API_KEY         — Google AI Studio key (required for ai-gateway)
# GEMINI_MODEL           — grading model, default: gemini-2.5-flash
# GEMINI_MODEL_LITE      — lint/diff model, default: gemini-2.5-flash-lite
