# Настройки проекта Centras CodeAI
# Скопируйте этот файл в .env и укажите ваши реальные ключи.

# ── Supabase (auth + база данных) ─────────────────────────────────────────
# Если не указано — проект работает в Demo Mode (LocalStorage).
VITE_SUPABASE_URL=ваш_supabase_url
VITE_SUPABASE_ANON_KEY=ваш_supabase_anon_key

# ── Gemini API (AI-проверка домашних работ) ───────────────────────────────
# Ключ используется напрямую из браузера через fetch к Google API.
# Если не указано — работает встроенный симулятор проверки (Demo Mode).
# Получить ключ: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=ваш_gemini_api_key
# Актуальные модели: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
VITE_GEMINI_MODEL=gemini-2.5-flash
