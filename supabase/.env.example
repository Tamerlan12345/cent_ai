# Секреты для Supabase Edge Functions (локальная разработка)
# Скопируйте этот файл в supabase/.env и укажите реальные ключи.
# Этот файл используется командой: supabase functions serve --env-file supabase/.env

# Ключ Gemini API — получить на: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ваш_gemini_api_key

# -------------------------------------------------------------------------
# Для продакшена (Supabase Cloud) используйте:
# supabase secrets set GEMINI_API_KEY=ваш_gemini_api_key
# -------------------------------------------------------------------------
